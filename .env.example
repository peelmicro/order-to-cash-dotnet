# Order-To-Cash (.NET) — environment template.
#
# Copy to `.env` and adjust. Every value here is a DEV DEFAULT: no account, no
# API key and no cloud service is needed anywhere in this stack.
#
# This file grows one phase at a time, like the README — it documents what
# exists, never what is planned. Phase 4 covers the infrastructure; the
# application variables arrive with the services that read them.

# ── General ───────────────────────────────────────────────────────────────
TZ=Europe/Madrid

# Docker Compose project namespace. Deliberately NOT `otc`: assessment #7
# (order-to-cash-nestjs) uses that, and its containers and volumes would
# collide name-for-name with these — #8 would silently adopt #7's Grafana
# database, MongoDB read model and Kafka log directory, corrupting the very
# comparison this trilogy exists to make.
#
# The LOGICAL database names below stay `otc_*`: those are shared-spec parity.
# Host ports are also unchanged from #7, so the two stacks cannot run at the
# same time — that is intended, one at a time.
COMPOSE_PROJECT_NAME=otcnet

# ── MS-SQL Server (src/Orders, src/Fulfillment, src/Billing, src/Notifications)
# One instance, four logical databases: database-per-service, no cross-database
# join, no foreign key across a service boundary.
#
# Password policy: SQL Server enforces complexity on the `sa` password at
# container start and refuses to boot if it is too weak — at least 8 chars with
# three of {uppercase, lowercase, digit, symbol}. A weak value here does not
# warn, it makes the container exit.
MSSQL_HOST_PORT=1433
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=Otc_Sa_Dev_Password_123!

# The application login. Created by infra/mssql/init/01-create-databases.sql
# with db_owner in each of the four databases — db_owner because EF Core
# migrations create, alter and drop objects. A least-privilege split between a
# migration principal and a runtime principal is a production concern, and the
# README says so rather than this compose file pretending to it.
MSSQL_APP_USER=otc_app
MSSQL_APP_PASSWORD=Otc_App_Dev_Password_123!

# Read by infra/mssql/entrypoint.sh and passed to the init script as sqlcmd
# variables, so these names have exactly one source of truth.
MSSQL_DB_ORDERS=otc_orders
MSSQL_DB_FULFILLMENT=otc_fulfillment
MSSQL_DB_BILLING=otc_billing
MSSQL_DB_NOTIFICATIONS=otc_notifications

# How long the entrypoint waits for the engine to answer before giving up.
# The engine alone needs ~20-30s on a cold start; the bootstrap runs after that.
MSSQL_READY_TIMEOUT_SECONDS=90

# ── MongoDB (read model — otc_read_model.order_timeline) ──────────────────
MONGO_HOST_PORT=27017
MONGO_INITDB_ROOT_USERNAME=otc_mongo_root
MONGO_INITDB_ROOT_PASSWORD=otc_mongo_dev_password
MONGO_DB_READMODEL=otc_read_model

# ── Kafka (fact stream, KRaft single-node — no ZooKeeper) ─────────────────
# Two listeners: containers reach the broker at kafka:29092, the host reaches
# it at localhost:9092. Using the wrong one is the classic Kafka-in-Docker
# failure — a client connects, gets told to talk to `kafka`, and cannot
# resolve it.
KAFKA_HOST_PORT=9092
KAFKA_INTERNAL_HOST=kafka
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=9093
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Partition count is above 1 to allow future consumer-group parallelism, and is
# safe for the saga's ordering guarantee: every producer keys these topics by
# `correlationId` (the order id), so all facts about one order hash to the same
# partition and are read in emission order. Replication is 1 — one broker.
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICATION_FACTOR=1

# Per-service Kafka client ids — two services sharing a client id makes
# broker-side metrics and logs ambiguous for no benefit (design.md §8.2 of
# fulfillment_stock). Orders' own producer defaults to otc-orders in code and
# has no .env entry of its own; Fulfillment's is added here as the second
# service to land one.
FULFILLMENT_KAFKA_CLIENT_ID=otc-fulfillment

# The Fulfillment responder's bounded concurrency (fulfillment_stock design.md
# §6.2) — must stay below ADO.NET's default Max Pool Size (100) so a lock
# convoy degrades into waiting rather than into pool-exhaustion timeouts.
FULFILLMENT_MAX_CONCURRENT_REQUESTS=32

# ── Redpanda Console (Kafka UI) + kafka-exporter (consumer lag) ───────────
REDPANDA_CONSOLE_HOST_PORT=8080
KAFKA_EXPORTER_HOST_PORT=9308

# ── NATS (RPC transport — core only, JetStream deliberately OFF) ──────────
# Durability is Kafka's job. Nothing on the RPC path needs replay: a timeout is
# a legitimate, handled answer. See specs/shared/asyncapi.yaml.
NATS_CLIENT_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222

# ── Mailpit (self-hosted SMTP sink + web inbox) ───────────────────────────
# Notification emails are really sent over SMTP and really land in an inbox you
# can open — against a local sink with no account, no quota and no password to
# leak. #7's lesson, inherited: a cloud sandbox rate-limited a topic replay and
# silently dead-lettered facts.
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
MAILPIT_MAX_MESSAGES=500

# ── Observability: OTel Collector → Jaeger, Prometheus, Grafana ───────────
OTEL_COLLECTOR_GRPC_HOST_PORT=4317
OTEL_COLLECTOR_HTTP_HOST_PORT=4318
JAEGER_UI_HOST_PORT=16686
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3030
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=otc_grafana_dev_password

# ── n8n (demo workflows, REST-only against the Gateway) ───────────────────
# Behind the `n8n` compose profile. The four workflow JSONs are reused
# unchanged from #7 — they speak only the Gateway's OpenAPI contract, which is
# why the base URL is the sole difference. Storage is SQLite (n8n's DB_TYPE
# accepts sqlite/postgresdb only); #7 also ended on SQLite.
N8N_HOST_PORT=5678
N8N_ENCRYPTION_KEY=otc_n8n_dev_encryption_key_change_me
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=otc_n8n_dev_password
N8N_WORKFLOWS_ENABLED=true

# The Gateway does not exist until Phase 13; these are the values the workflows
# will use when it does, declared here because the n8n container reads them at
# start and an unset variable is harder to debug than a documented one.
GATEWAY_PORT=3001
GATEWAY_OPERATOR_USERNAME=operator
GATEWAY_OPERATOR_PASSWORD=otc_operator_dev_password_change_me
OTC_REQUEST_TIMEOUT_MS=10000

ORDER_GENERATOR_ENABLED=true
ORDER_GENERATOR_INTERVAL_SECONDS=45
ORDER_GENERATOR_ORDERS_PER_RUN=1
ORDER_GENERATOR_COMPENSATION_RATIO=0.15
ORDER_GENERATOR_MAX_LINES=4
ORDER_GENERATOR_MAX_UNITS=10
ORDER_GENERATOR_RETAILERS=
ORDER_GENERATOR_COMPANIES=
ORDER_GENERATOR_CATALOG_TTL_SECONDS=600

PAYMENT_ROBOT_ENABLED=true
PAYMENT_ROBOT_INTERVAL_SECONDS=120
PAYMENT_AGE_MINUTES=2
PAYMENT_ROBOT_BATCH_SIZE=10
PAYMENT_ROBOT_RETAILERS=

STOCK_REPLENISH_ENABLED=true
STOCK_REPLENISH_INTERVAL_SECONDS=300
STOCK_REPLENISH_TOP_UP_UNITS=100
STOCK_REPLENISH_BATCH_SIZE=50
STOCK_REPLENISH_COMPANIES=

BURST_ENABLED=true
BURST_ORDER_COUNT=20
BURST_CONCURRENCY=5
BURST_COMPENSATION_RATIO=0.20
BURST_WEBHOOK_PATH=otc-burst

# ── SonarQube (opt-in, compose profile "sonar", ~1.5 GB RAM) ──────────────
# Coverage gates are enforced by ./quality.sh regardless, so code quality never
# depends on this container running.
SONARQUBE_HOST_PORT=9000
