<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    One PackageVersion per package, pinned solution-wide. Versions below are
    the ones verified working for this assessment — do not go hunting for
    newer ones without re-verifying against the compose stack.
  -->
  <ItemGroup>
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="coverlet.msbuild" Version="6.0.2" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />

    <!-- feature cqrs_dispatcher (phase 8): the hand-rolled in-process CQRS
         dispatcher's only package — resolves ICommandHandler/IQueryHandler/
         IEventHandler implementations from IServiceProvider and exposes the
         IServiceCollection.AddDispatcher scan-and-register extension. Same
         version band as the EF Core / EF Design packages below. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <!-- tests/Cqrs.UnitTests only — the concrete ServiceCollection /
         BuildServiceProvider implementation used to prove resolution and the
         startup validation pass end to end. Same version band as the
         Abstractions package above. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />

    <!-- Infrastructure (not consumed until later features; pinned now so
         every service resolves the same version when it is wired in) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <!-- Design-time services for `dotnet ef migrations add` — build-time only
         (PrivateAssets="all" at the ItemGroup in each consuming .csproj), same
         version band as Microsoft.EntityFrameworkCore.SqlServer and the
         globally-installed dotnet-ef 10.0.11 (feature db_orders, phase 6). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Confluent.Kafka" Version="2.15.0" />
    <PackageVersion Include="NATS.Net" Version="3.2.0" />
    <PackageVersion Include="MongoDB.Driver" Version="3.11.1" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.14.0" />
    <!-- feature seed_job: real MongoDB container for the order_timeline
         parity tests (CLAUDE.md testing conventions — never a mocked
         broker/store). Same major.minor band as Testcontainers.MsSql. -->
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.14.0" />
  </ItemGroup>

</Project>
