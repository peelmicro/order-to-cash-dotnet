<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OrderToCash.Fulfillment.IntegrationTests</RootNamespace>
    <AssemblyName>OrderToCash.Fulfillment.IntegrationTests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Real MS-SQL container — never a mock, never SQLite-in-memory
         (CLAUDE.md testing conventions). -->
    <PackageReference Include="Testcontainers.MsSql" />
    <!-- KafkaContainerFixture and NatsContainerFixture only — the generic
         Testcontainers ContainerBuilder drives both apache/kafka:4.3.1 and
         nats:2.14.5-alpine directly (Testcontainers.Kafka is deliberately
         NOT referenced — see KafkaContainerFixture's own remarks, copied
         verbatim from tests/Orders.IntegrationTests). -->
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="NATS.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Fulfillment/Fulfillment.csproj" />
  </ItemGroup>

</Project>
