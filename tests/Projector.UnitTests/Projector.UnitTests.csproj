<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OrderToCash.Projector.UnitTests</RootNamespace>
    <AssemblyName>OrderToCash.Projector.UnitTests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- ProjectorDispatcherRegistrationTests only — a real
         ServiceCollection/ServiceProvider, never a mock container. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- KafkaFactStreamSubscriberConfigTests (PR38) only — reflects into the
         private BuildConsumerConfig to read the ConsumerConfig it builds. -->
    <PackageReference Include="Confluent.Kafka" />
    <!-- DeltaToPipelineTests / PlaceholderDocumentTests (unit half) only —
         asserting the emitted BsonDocument stage tree, no container. -->
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Projector/Projector.csproj" />
    <ProjectReference Include="../../src/SharedKernel/SharedKernel.csproj" />
    <ProjectReference Include="../../src/Contracts/Contracts.csproj" />
    <ProjectReference Include="../../src/Cqrs/Cqrs.csproj" />
    <!-- Read-only oracle for PR40 (MongoSeedWriter's private _statusRank
         table, TimelineOrderVersion). src/Projector/Projector.csproj itself
         must NEVER reference Seed (PR21 — Seed drags EF Core in
         transitively via Orders/Fulfillment/Billing); this test project's
         reference is scoped by requirements.md §5. -->
    <ProjectReference Include="../../src/Seed/Seed.csproj" />
  </ItemGroup>

</Project>
