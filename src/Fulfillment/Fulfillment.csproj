<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OrderToCash.Fulfillment</RootNamespace>
    <AssemblyName>OrderToCash.Fulfillment</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SharedKernel/SharedKernel.csproj" />
    <ProjectReference Include="../Contracts/Contracts.csproj" />
    <!-- Application/Commands, Application/Queries only — the hand-rolled
         dispatcher (CLAUDE.md's binding dispatcher ruling, Phase 8 gate).
         No Domain/ namespace may reference OrderToCash.Cqrs:
         CqrsDomainPurityTests fails the build if one ever does. -->
    <ProjectReference Include="../Cqrs/Cqrs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Persistence only — the FulfillmentDbContext for
         otc_fulfillment (feature db_fulfillment). Never referenced from
         Domain/: NetArchTest's DomainPurityTests fails the build if it ever
         is. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Outbox only — the fact-stream producer (feature
         fulfillment_stock, copied from Orders' outbox_and_idempotency).
         tests/Architecture.Tests/FactPublisherConfinementTests.cs fails the
         build if any type outside *.Infrastructure.Outbox depends on
         Confluent.Kafka. -->
    <PackageReference Include="Confluent.Kafka" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Messaging and Presentation only — the RPC transport
         (specs/shared/asyncapi.yaml rpcTransport server: "NATS core
         request-reply. No durability, no replay, no stream"). -->
    <PackageReference Include="NATS.Net" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Observability only — feature observability_reliability
         (phase 14, group A3): the OTel SDK, its OTLP exporter and its
         hosting registration extension (design.md §9.1). -->
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Health only — feature observability_reliability
         (phase 14, group A4): design.md §8.1's HealthProbeService. A
         FrameworkReference, NOT a NuGet package — no Directory.Packages.props
         entry, no new PackageVersion. Its shared framework already carries
         Microsoft.Extensions.Hosting[.Abstractions]/Options/Logging.Abstractions,
         which is why those four PackageReferences (previously used for
         Program.cs, the outbox relay and the responder's IOptions/ILogger
         sites) were REMOVED above rather than kept alongside this
         FrameworkReference — NuGet's package-pruning warning (NU1510, an
         error under this repository's TreatWarningsAsErrors) fails the
         build otherwise, the same fix Orders.csproj needed first. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
