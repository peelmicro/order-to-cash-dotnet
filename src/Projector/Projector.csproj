<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OrderToCash.Projector</RootNamespace>
    <AssemblyName>OrderToCash.Projector</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SharedKernel/SharedKernel.csproj" />
    <ProjectReference Include="../Contracts/Contracts.csproj" />
    <!-- Application/Commands only — the hand-rolled dispatcher (CLAUDE.md's
         binding dispatcher ruling, Phase 8 gate). No Domain/ namespace may
         reference OrderToCash.Cqrs: CqrsDomainPurityTests fails the build if
         one ever does. -->
    <ProjectReference Include="../Cqrs/Cqrs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Persistence only — the only runtime writer of
         otc_read_model.order_timeline (R54). No Domain/ namespace may
         reference MongoDB.Driver: DomainPurityTests fails the build if one
         ever does. -->
    <PackageReference Include="MongoDB.Driver" />
    <!-- Infrastructure/Messaging/Consumers only — the fact-stream consumer.
         tests/Architecture.Tests/FactConsumerConfinementTests.cs fails the
         build if any type outside *.Infrastructure.Messaging.Consumers
         depends on Confluent.Kafka's consumer types. -->
    <PackageReference Include="Confluent.Kafka" />
    <!-- Infrastructure/Signal + the DI extension only — the update signal
         (R55), a publish-only NATS client, never a request. -->
    <PackageReference Include="NATS.Net" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Observability only — feature observability_reliability
         (phase 14, group A3): the OTel SDK, its OTLP exporter and its
         hosting registration extension (design.md §9.1). -->
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Health only — feature observability_reliability
         (phase 14, group A4): design.md §8.1's HealthProbeService. A
         FrameworkReference, NOT a NuGet package. Its shared framework
         already carries Microsoft.Extensions.Hosting/Options/Logging.Abstractions
         (previously used for Program.cs, ProjectorHost and every
         BackgroundService/IHostedService/IOptions&lt;T&gt;/ILogger&lt;T&gt;
         site), which is why those three PackageReferences were REMOVED
         above rather than kept alongside this FrameworkReference —
         NuGet's package-pruning warning (NU1510, an error under
         TreatWarningsAsErrors) fails the build otherwise. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
