<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OrderToCash.Orders</RootNamespace>
    <AssemblyName>OrderToCash.Orders</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SharedKernel/SharedKernel.csproj" />
    <ProjectReference Include="../Contracts/Contracts.csproj" />
    <!-- Application/Commands only — the hand-rolled dispatcher (feature
         orders_acceptance is its first consumer, CLAUDE.md's binding
         dispatcher ruling). No Domain/ namespace may reference
         OrderToCash.Cqrs: CqrsDomainPurityTests fails the build if one ever
         does. -->
    <ProjectReference Include="../Cqrs/Cqrs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Persistence only — the OrdersDbContext for otc_orders
         (feature db_orders). Never referenced from Domain/: NetArchTest's
         DomainPurityTests fails the build if it ever is. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Outbox only — the fact-stream producer (feature
         outbox_and_idempotency). tests/Architecture.Tests/
         FactPublisherConfinementTests.cs fails the build if any type outside
         *.Infrastructure.Outbox depends on Confluent.Kafka, and
         DomainPurityTests already fails it for Domain/. -->
    <PackageReference Include="Confluent.Kafka" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Messaging (the outbound fulfillment.stock.check RPC
         client) and Presentation (the orders.create NATS responder) only —
         the RPC transport (feature orders_acceptance, specs/shared/asyncapi.yaml
         rpcTransport server: "NATS core request-reply. No durability, no
         replay, no stream"). -->
    <PackageReference Include="NATS.Net" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Observability only — feature observability_reliability
         (phase 14, group A3): the OTel SDK, its OTLP exporter and its
         hosting registration extension (design.md §9.1). -->
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Health only — feature observability_reliability
         (phase 14, group A4): design.md §8.1's HealthProbeService, a
         minimal WebApplication built inside IHostedService.StartAsync
         mapping GET /health/live and GET /health/ready. A FrameworkReference,
         NOT a NuGet package — no Directory.Packages.props entry, no new
         PackageVersion (tasks.md A4a's own arming target).

         NuGet's package-pruning warning (NU1510, an error under this
         repository's TreatWarningsAsErrors) is why the four
         Microsoft.Extensions.Hosting[.Abstractions]/Options/Logging.Abstractions
         PackageReferences above were REMOVED rather than left alongside
         this FrameworkReference: Microsoft.AspNetCore.App's shared
         framework already carries all four (the same reason Gateway.csproj
         — Sdk.Web, which brings this FrameworkReference in implicitly —
         never referenced them as packages either), so keeping the explicit
         PackageReferences became a build error, not a redundancy. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
