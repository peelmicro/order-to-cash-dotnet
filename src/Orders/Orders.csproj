<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OrderToCash.Orders</RootNamespace>
    <AssemblyName>OrderToCash.Orders</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SharedKernel/SharedKernel.csproj" />
    <ProjectReference Include="../Contracts/Contracts.csproj" />
    <!-- Application/Commands only — the hand-rolled dispatcher (feature
         orders_acceptance is its first consumer, CLAUDE.md's binding
         dispatcher ruling). No Domain/ namespace may reference
         OrderToCash.Cqrs: CqrsDomainPurityTests fails the build if one ever
         does. -->
    <ProjectReference Include="../Cqrs/Cqrs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Persistence only — the OrdersDbContext for otc_orders
         (feature db_orders). Never referenced from Domain/: NetArchTest's
         DomainPurityTests fails the build if it ever is. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Outbox only — the fact-stream producer (feature
         outbox_and_idempotency). tests/Architecture.Tests/
         FactPublisherConfinementTests.cs fails the build if any type outside
         *.Infrastructure.Outbox depends on Confluent.Kafka, and
         DomainPurityTests already fails it for Domain/. -->
    <PackageReference Include="Confluent.Kafka" />
    <!-- Infrastructure/Outbox only — OutboxRelayBackgroundService's
         BackgroundService/IHostedService shape. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- Infrastructure/Outbox only — IOptions<OutboxRelayOptions>. -->
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- Infrastructure/Outbox only — ILogger<T> on the relay and the
         producer adapter. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Messaging (the outbound fulfillment.stock.check RPC
         client) and Presentation (the orders.create NATS responder) only —
         the RPC transport (feature orders_acceptance, specs/shared/asyncapi.yaml
         rpcTransport server: "NATS core request-reply. No durability, no
         replay, no stream"). -->
    <PackageReference Include="NATS.Net" />
  </ItemGroup>

  <ItemGroup>
    <!-- Program.cs only — feature orders_acceptance is the first feature to
         build a runnable Orders host (outbox_and_idempotency design.md
         §2.3: "this feature does not write one"). Microsoft.Extensions.Hosting.Abstractions
         (BackgroundService/IHostedService) was already referenced for the
         outbox relay; this is the full host builder
         (Host.CreateApplicationBuilder) that RUNS them. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
