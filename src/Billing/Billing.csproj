<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OrderToCash.Billing</RootNamespace>
    <AssemblyName>OrderToCash.Billing</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SharedKernel/SharedKernel.csproj" />
    <ProjectReference Include="../Contracts/Contracts.csproj" />
    <!-- Application/Commands, Application/Queries only — the hand-rolled
         dispatcher (CLAUDE.md's binding dispatcher ruling, Phase 8 gate).
         No Domain/ namespace may reference OrderToCash.Cqrs:
         CqrsDomainPurityTests fails the build if one ever does. -->
    <ProjectReference Include="../Cqrs/Cqrs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Persistence only — the BillingDbContext for
         otc_billing (feature db_billing). Never referenced from Domain/:
         NetArchTest's DomainPurityTests fails the build if it ever is. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Outbox only — the fact-stream producer (design.md
         §8, the third copy of the outbox-relay family). Architecture
         tests fail the build if any type outside *.Infrastructure.Outbox
         depends on Confluent.Kafka. -->
    <PackageReference Include="Confluent.Kafka" />
    <!-- Infrastructure/Outbox and Presentation (CreditRpcResponder is a
         BackgroundService) — the host's BackgroundService/IHostedService
         shape. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- Infrastructure/Outbox, Infrastructure (BillingOptions) and
         Presentation (responder options) — IOptions&lt;T&gt;. -->
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- Infrastructure/Outbox and Presentation — ILogger&lt;T&gt; on the
         relay, the producer adapter and the responder. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure/Messaging and Presentation only — the RPC transport
         (specs/shared/asyncapi.yaml rpcTransport server: "NATS core
         request-reply. No durability, no replay, no stream"). -->
    <PackageReference Include="NATS.Net" />
  </ItemGroup>

  <ItemGroup>
    <!-- Program.cs only — the first runnable Billing host (design.md §14.3). -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
