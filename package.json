{
  "name": "order-to-cash-dotnet",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "description": "Order-To-Cash — order lifecycle backbone for a B2B EDI / e-invoicing platform (assessment #8 of a trilogy). Command shortcuts only: the backend is .NET, and apps/web keeps its own package.json and lockfile.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "--- HARNESS & QUALITY ---": "",
    "init": "./init.sh",
    "quality": "./quality.sh",
    "quality:web": "QUALITY_ONLY=web ./quality.sh",
    "build": "dotnet build OrderToCash.sln",
    "format": "dotnet format OrderToCash.sln --verify-no-changes",
    "format:fix": "dotnet format OrderToCash.sln",
    "test": "dotnet test OrderToCash.sln",
    "test:unit": "dotnet test OrderToCash.sln --filter \"FullyQualifiedName!~.IntegrationTests.\"",
    "test:integration": "dotnet test OrderToCash.sln --filter \"FullyQualifiedName~.IntegrationTests.\"",

    "--- CONTRACTS ---": "",
    "contracts:generate": "pnpm --dir apps/web run types:generate",
    "contracts:check": "pnpm --dir apps/web run types:check",

    "--- DATABASE (the seed job also applies every migration) ---": "",
    "db:migrate:orders": "scripts/dev-stack.sh env dotnet ef database update --project src/Orders",
    "db:migrate:fulfillment": "scripts/dev-stack.sh env dotnet ef database update --project src/Fulfillment",
    "db:migrate:billing": "scripts/dev-stack.sh env dotnet ef database update --project src/Billing",
    "db:migrate:notifications": "scripts/dev-stack.sh env dotnet ef database update --project src/Notifications",
    "seed": "scripts/dev-stack.sh env dotnet run --project src/Seed",

    "--- LOCAL DEV (one terminal each, foreground) ---": "",
    "dev:gateway": "scripts/dev-stack.sh env dotnet run --project src/Gateway",
    "dev:orders": "scripts/dev-stack.sh env dotnet run --project src/Orders",
    "dev:fulfillment": "scripts/dev-stack.sh env dotnet run --project src/Fulfillment",
    "dev:billing": "scripts/dev-stack.sh env dotnet run --project src/Billing",
    "dev:notifications": "scripts/dev-stack.sh env dotnet run --project src/Notifications",
    "dev:projector": "scripts/dev-stack.sh env dotnet run --project src/Projector",
    "dev:web": "scripts/dev-stack.sh env pnpm --dir apps/web run dev",

    "--- WHOLE STACK (background: build, seed, six services, web) ---": "",
    "stack:start": "scripts/dev-stack.sh start",
    "stack:stop": "scripts/dev-stack.sh stop",
    "stack:status": "scripts/dev-stack.sh status",

    "--- WEB APP ---": "",
    "web:install": "pnpm --dir apps/web install --frozen-lockfile",
    "web:build": "pnpm --dir apps/web run build",
    "web:start": "scripts/dev-stack.sh env pnpm --dir apps/web run start",
    "web:lint": "pnpm --dir apps/web run lint",
    "web:typecheck": "pnpm --dir apps/web run typecheck",
    "web:test": "pnpm --dir apps/web run test",
    "web:test:coverage": "pnpm --dir apps/web run test:coverage",
    "web:test:integration": "pnpm --dir apps/web run test:integration",

    "--- INFRASTRUCTURE ---": "",
    "dc:up:infra": "docker compose -f docker-compose.infra.yml --profile n8n up -d",
    "dc:up:infra:no-n8n": "docker compose -f docker-compose.infra.yml up -d",
    "kafka:topics": "docker compose -f docker-compose.infra.yml run --rm kafka-init",
    "dc:down:infra": "docker compose -f docker-compose.infra.yml --profile n8n down",
    "dc:ps:infra": "docker compose -f docker-compose.infra.yml --profile n8n ps",
    "dc:clean:infra": "docker compose -f docker-compose.infra.yml --profile n8n down -v",
    "dc:logs:infra": "docker compose -f docker-compose.infra.yml logs -f",
    "dc:logs:mssql": "docker compose -f docker-compose.infra.yml logs -f mssql",
    "dc:logs:mongodb": "docker compose -f docker-compose.infra.yml logs -f mongodb",
    "dc:logs:kafka": "docker compose -f docker-compose.infra.yml logs -f kafka",
    "dc:logs:kafka-console": "docker compose -f docker-compose.infra.yml logs -f kafka-console",
    "dc:logs:kafka-exporter": "docker compose -f docker-compose.infra.yml logs -f kafka-exporter",
    "dc:logs:nats": "docker compose -f docker-compose.infra.yml logs -f nats",
    "dc:logs:mailpit": "docker compose -f docker-compose.infra.yml logs -f mailpit",
    "dc:logs:otel-collector": "docker compose -f docker-compose.infra.yml logs -f otel-collector",
    "dc:logs:jaeger": "docker compose -f docker-compose.infra.yml logs -f jaeger",
    "dc:logs:prometheus": "docker compose -f docker-compose.infra.yml logs -f prometheus",
    "dc:logs:grafana": "docker compose -f docker-compose.infra.yml logs -f grafana",
    "dc:logs:n8n": "docker compose -f docker-compose.infra.yml --profile n8n logs -f n8n",
    "dc:up:sonar": "docker compose -f docker-compose.infra.yml --profile sonar up -d sonarqube",
    "dc:down:sonar": "docker compose -f docker-compose.infra.yml --profile sonar stop sonarqube",
    "dc:logs:sonarqube": "docker compose -f docker-compose.infra.yml --profile sonar logs -f sonarqube",

    "--- DEMO ---": "",
    "saga:watch": "docker exec otcnet-mssql bash -c '/opt/mssql-tools18/bin/sqlcmd -C -S localhost -U sa -P \"$MSSQL_SA_PASSWORD\" -d \"$MSSQL_DB_ORDERS\" -W -Q \"SET NOCOUNT ON; SELECT order_reference, status, cancellation_reason FROM orders ORDER BY order_reference; SELECT command, status, COUNT(*) AS n FROM saga_commands GROUP BY command, status\"'"
  }
}
