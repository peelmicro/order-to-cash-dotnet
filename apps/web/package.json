{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env ./node_modules/next/dist/bin/next dev --port ${WEB_PORT:-3010}",
    "build": "next build",
    "start": "node --env-file-if-exists=../../.env ./node_modules/next/dist/bin/next start --port ${WEB_PORT:-3010}",
    "lint": "eslint . --max-warnings 0 && node scripts/lint-coverage.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node --env-file-if-exists=../../.env ./node_modules/@playwright/test/cli.js test",
    "types:generate": "node scripts/openapi-types.mjs generate",
    "types:check": "node scripts/openapi-types.mjs check"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "iron-session": "9.0.1",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eventsource": "5.1.1",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
