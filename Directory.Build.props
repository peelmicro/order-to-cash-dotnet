<Project>

  <!--
    Analyzer SEVERITIES (which rules exist, how loudly they complain) live in
    the root .editorconfig. Analyzer ENFORCEMENT (whether a warning stops the
    build) lives here, in Directory.Build.props. Keep it that way — do not
    duplicate severities in this file, and do not move TreatWarningsAsErrors
    into .editorconfig.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      Read by the VSTest tasks for every project regardless of how
      `dotnet test` is invoked (solution-level, as quality.sh does, or a
      bare `dotnet test` in a single project) — see test.runsettings for
      why. Harmless for non-test (src/) projects: RunSettingsFilePath is
      ignored outside a test run.
    -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)test.runsettings</RunSettingsFilePath>
  </PropertyGroup>

</Project>
